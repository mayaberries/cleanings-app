---
import AdminLayout from "../layout/AdminLayout.astro";


export const prerender = false;

const user = Astro.locals.user!;
---

<AdminLayout title="Overview" user={user}>
    <h1 class="font-display font-700 text-2xl text-ink mb-2">Signed in as {user.email}</h1>
    <p class="text-sm text-inksoft max-w-xl">
        {user.isSuperuser
            ? "Superadmin session — clinics list + site launch panel come next."
            : `Clinic admin session (clinic ${user.clinicId}) — overview/appointments/services tabs come next.`}
    </p>
</AdminLayout>