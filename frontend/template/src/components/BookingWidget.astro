---
// No real functionality added yet: this is the same static-demo widget
// from the HTML prototype (deterministic pseudo-random slots, no backend),
// just moved into Astro so it can live inside the page as one component.
---

<section id="booking" class="max-w-6xl mx-auto px-6 py-20 md:py-28">
  <div class="text-center max-w-xl mx-auto mb-10">
    <p class="font-mono text-xs uppercase tracking-widest text-teal mb-3">Last step</p>
    <h2 class="font-display font-700 text-3xl md:text-4xl text-ink mb-3">Book your visit</h2>
    <p class="text-inksoft leading-relaxed">
      Choose a time that works, add your pet's info, and you're set. We'll send a confirmation
      right away.
    </p>
  </div>

  <!-- Everything inside #pet-booking-widget is the embeddable unit. -->
  <div id="scheduling-widget-root">
    <div
      id="pet-booking-widget"
      class="w-full max-w-5xl mx-auto bg-white rounded-2xl border border-line shadow-sm overflow-hidden"
    >
      <div class="grid grid-cols-1 md:grid-cols-[320px_1fr]">
        <!-- ============ LEFT: service context + step tracker ============ -->
        <aside class="bg-panel border-b md:border-b-0 md:border-r border-line p-6 sm:p-8 flex flex-col">
          <p class="text-sm text-muted leading-relaxed mb-8">
            A nose-to-tail once-over for dogs, cats, and small companions — weight, vitals, and a
            chance to flag anything worth watching before it becomes a bigger deal.
          </p>

          <div class="mt-auto pt-2 hidden md:block">
            <ol class="relative pl-8">
              <li class="relative pb-8" data-step-indicator="1">
                <span class="absolute left-[-2rem] top-0 w-8 flex justify-center leash-line h-full"></span>
                <span
                  data-step-dot="1"
                  class="absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-[11px] font-semibold paw-marker"
                  >1</span
                >
                <p data-step-label="1" class="text-sm font-semibold text-ink">Date &amp; time</p>
                <p class="text-xs text-muted">Pick what works for you</p>
              </li>
              <li class="relative pb-8" data-step-indicator="2">
                <span class="absolute left-[-2rem] top-0 w-8 flex justify-center leash-line h-full"></span>
                <span
                  data-step-dot="2"
                  class="absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-white border-2 border-line text-muted flex items-center justify-center text-[11px] font-semibold"
                  >2</span
                >
                <p data-step-label="2" class="text-sm font-semibold text-muted">Pet &amp; owner details</p>
                <p class="text-xs text-muted">Who we're seeing</p>
              </li>
              <li class="relative" data-step-indicator="3">
                <span
                  data-step-dot="3"
                  class="absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-white border-2 border-line text-muted flex items-center justify-center text-[11px] font-semibold"
                  >3</span
                >
                <p data-step-label="3" class="text-sm font-semibold text-muted">Confirm</p>
                <p class="text-xs text-muted">You're on the schedule</p>
              </li>
            </ol>
          </div>
        </aside>

        <!-- ============ RIGHT: interactive panel ============ -->
        <main class="p-6 sm:p-8 relative min-h-[560px]">
          <!-- STEP 1: calendar + time slots -->
          <section id="step-datetime">
            <h2 class="font-display text-lg font-semibold mb-1">Select a date &amp; time</h2>
            <p class="text-sm text-muted mb-5">Times shown in your local timezone.</p>

            <div class="grid grid-cols-1 sm:grid-cols-[1fr_220px] gap-6">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <button
                    id="prev-month"
                    type="button"
                    aria-label="Previous month"
                    class="w-8 h-8 rounded-full border border-line flex items-center justify-center text-muted hover:text-ink hover:border-ink/40 transition disabled:opacity-30 disabled:hover:border-line disabled:hover:text-muted disabled:cursor-not-allowed"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                      ><path d="M15 6l-6 6 6 6" /></svg
                    >
                  </button>
                  <p id="month-label" class="text-sm font-semibold"></p>
                  <button
                    id="next-month"
                    type="button"
                    aria-label="Next month"
                    class="w-8 h-8 rounded-full border border-line flex items-center justify-center text-muted hover:text-ink hover:border-ink/40 transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                      ><path d="M9 6l6 6-6 6" /></svg
                    >
                  </button>
                </div>
                <div class="grid grid-cols-7 gap-y-1 text-center text-[11px] font-medium text-muted mb-1">
                  <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                </div>
                <div id="calendar-grid" class="grid grid-cols-7 gap-y-1 text-center text-sm"></div>
              </div>

              <div class="border-t sm:border-t-0 sm:border-l border-line pt-5 sm:pt-0 sm:pl-6">
                <p id="slots-heading" class="text-sm font-semibold mb-3">Pick a date</p>
                <div id="slots-list" class="space-y-2 max-h-[320px] overflow-y-auto pr-1 font-mono text-sm"></div>
              </div>
            </div>

            <div class="mt-6 flex justify-end">
              <button
                id="continue-btn"
                type="button"
                disabled
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-semibold opacity-40 cursor-not-allowed transition hover:bg-primary-dark"
              >
                Continue
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                  ><path d="M9 6l6 6-6 6" /></svg
                >
              </button>
            </div>
          </section>

          <!-- STEP 2: pet + owner details -->
          <section id="step-details" class="hidden">
            <button id="back-to-datetime" type="button" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink mb-4 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M15 6l-6 6 6 6" /></svg
              >
              Back
            </button>

            <div id="selection-summary" class="flex items-start gap-3 bg-accent-light border border-accent/30 rounded-xl px-4 py-3 mb-6 text-sm">
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent-dark" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg
              >
              <span id="selection-summary-text" class="text-ink"></span>
            </div>

            <h2 class="font-display text-lg font-semibold mb-4">Tell us about your pet</h2>

            <form id="booking-form" class="space-y-5">
              <div>
                <label class="block text-sm font-medium mb-2">Who's coming in?</label>
                <div class="grid grid-cols-4 gap-2" id="species-picker">
                  <button type="button" data-species="Dog" class="species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition">
                    <span class="text-lg">🐕</span> Dog
                  </button>
                  <button type="button" data-species="Cat" class="species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition">
                    <span class="text-lg">🐈</span> Cat
                  </button>
                  <button type="button" data-species="Bird" class="species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition">
                    <span class="text-lg">🦜</span> Bird
                  </button>
                  <button type="button" data-species="Other" class="species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition">
                    <span class="text-lg">🐾</span> Other
                  </button>
                </div>
                <input type="hidden" id="pet-species" required />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="pet-name" class="block text-sm font-medium mb-1.5">Pet's name</label>
                  <input
                    id="pet-name"
                    type="text"
                    required
                    placeholder="Biscuit"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
                  />
                </div>
                <div>
                  <label for="pet-age" class="block text-sm font-medium mb-1.5">
                    Age <span class="text-muted font-normal">(optional)</span>
                  </label>
                  <input
                    id="pet-age"
                    type="text"
                    placeholder="2 years"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
                  />
                </div>
              </div>

              <div>
                <label for="owner-name" class="block text-sm font-medium mb-1.5">Your name</label>
                <input
                  id="owner-name"
                  type="text"
                  required
                  placeholder="Jordan Alvarez"
                  class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
                />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="owner-phone" class="block text-sm font-medium mb-1.5">Phone</label>
                  <input
                    id="owner-phone"
                    type="tel"
                    required
                    placeholder="(555) 123-4567"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
                  />
                </div>
                <div>
                  <label for="owner-email" class="block text-sm font-medium mb-1.5">Email</label>
                  <input
                    id="owner-email"
                    type="email"
                    required
                    placeholder="jordan@email.com"
                    class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary"
                  />
                </div>
              </div>

              <div>
                <label for="notes" class="block text-sm font-medium mb-1.5">
                  Anything we should know? <span class="text-muted font-normal">(optional)</span>
                </label>
                <textarea
                  id="notes"
                  rows="3"
                  placeholder="Nervous around other animals, recent limping, allergies…"
                  class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary resize-none"
                ></textarea>
              </div>

              <p id="form-error" class="hidden text-sm text-red-600"></p>

              <button
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-dark transition"
              >
                Confirm booking
              </button>
            </form>
          </section>

          <!-- STEP 3: confirmation -->
          <section id="step-confirm" class="hidden">
            <div class="flex flex-col items-center text-center max-w-sm mx-auto py-6">
              <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-5">
                <svg viewBox="0 0 24 24" class="w-7 h-7 fill-primary">
                  <ellipse cx="12" cy="15.2" rx="5.4" ry="4.6" />
                  <ellipse cx="5.4" cy="9.6" rx="2.1" ry="2.6" />
                  <ellipse cx="18.6" cy="9.6" rx="2.1" ry="2.6" />
                  <ellipse cx="8.5" cy="5.2" rx="1.8" ry="2.3" />
                  <ellipse cx="15.5" cy="5.2" rx="1.8" ry="2.3" />
                </svg>
              </div>
              <h2 class="font-display text-xl font-semibold mb-2">You're booked in</h2>
              <p class="text-sm text-muted mb-6">
                A confirmation is on its way to <span id="confirm-email" class="text-ink font-medium"></span>.
                We'll text a reminder the day before.
              </p>

              <div class="w-full text-left bg-panel border border-line rounded-xl p-4 mb-6 text-sm space-y-2">
                <div class="flex justify-between"><span class="text-muted">Pet</span><span id="confirm-pet" class="font-medium"></span></div>
                <div class="flex justify-between"><span class="text-muted">Date</span><span id="confirm-date" class="font-medium"></span></div>
                <div class="flex justify-between"><span class="text-muted">Time</span><span id="confirm-time" class="font-mono font-medium"></span></div>
                <div class="flex justify-between"><span class="text-muted">Location</span><span class="font-medium">NovaVet Animal Hospital</span></div>
              </div>

              <div class="flex flex-col sm:flex-row gap-3 w-full">
                <button id="add-to-calendar" type="button" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-line text-sm font-semibold hover:border-primary hover:text-primary transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
                    ><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg
                  >
                  Add to calendar
                </button>
                <button id="book-another" type="button" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-dark transition">
                  Book another visit
                </button>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    "use strict";

    // ---------- State ----------
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let selectedDate: Date | null = null;
    let selectedTime: string | null = null;
    const APPT_MINUTES = 30;

    const monthLabel = document.getElementById("month-label")!;
    const calendarGrid = document.getElementById("calendar-grid")!;
    const prevBtn = document.getElementById("prev-month") as HTMLButtonElement;
    const nextBtn = document.getElementById("next-month") as HTMLButtonElement;
    const slotsList = document.getElementById("slots-list")!;
    const slotsHeading = document.getElementById("slots-heading")!;
    const continueBtn = document.getElementById("continue-btn") as HTMLButtonElement;

    const MONTH_NAMES = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    const DAY_NAMES = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];

    // ---------- Deterministic pseudo-random availability ----------
    function seededHash(str: string) {
      let h = 0;
      for (let i = 0; i < str.length; i++) { h = (h * 31 + str.charCodeAt(i)) >>> 0; }
      return h;
    }

    function getSlotsForDate(date: Date) {
      const dow = date.getDay();
      if (dow === 0) return [];
      const start = dow === 6 ? 10 * 60 : 9 * 60;
      const end = dow === 6 ? 14 * 60 : 17 * 60;
      const lunchStart = 12 * 60, lunchEnd = 13 * 60;
      const slots: { time: string; available: boolean }[] = [];
      const dateKey = date.toISOString().slice(0, 10);
      for (let mins = start; mins < end; mins += APPT_MINUTES) {
        if (mins >= lunchStart && mins < lunchEnd) continue;
        const h24 = Math.floor(mins / 60);
        const m = mins % 60;
        const h12 = ((h24 + 11) % 12) + 1;
        const ampm = h24 < 12 ? "AM" : "PM";
        const label = `${h12}:${m.toString().padStart(2, "0")} ${ampm}`;
        const booked = seededHash(dateKey + label) % 5 === 0;
        slots.push({ time: label, available: !booked });
      }
      return slots;
    }

    // ---------- Calendar rendering ----------
    function renderCalendar() {
      monthLabel.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
      calendarGrid.innerHTML = "";

      const firstOfMonth = new Date(viewYear, viewMonth, 1);
      const startOffset = firstOfMonth.getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      const isCurrentRealMonth = viewYear === today.getFullYear() && viewMonth === today.getMonth();
      prevBtn.disabled = isCurrentRealMonth;

      for (let i = 0; i < startOffset; i++) {
        calendarGrid.appendChild(document.createElement("div"));
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const cellDate = new Date(viewYear, viewMonth, d);
        const isPast = cellDate < today;
        const isClosed = cellDate.getDay() === 0;
        const isSelected = selectedDate && cellDate.getTime() === selectedDate.getTime();

        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = String(d);
        btn.setAttribute("aria-label", `${DAY_NAMES[cellDate.getDay()]}, ${MONTH_NAMES[viewMonth]} ${d}`);

        let cls = "w-9 h-9 mx-auto flex items-center justify-center rounded-full transition ";
        if (isPast || isClosed) {
          cls += "text-line cursor-not-allowed";
          btn.disabled = true;
        } else if (isSelected) {
          cls += "bg-primary text-white font-semibold";
        } else {
          cls += "text-ink hover:bg-accent-light border border-transparent hover:border-accent/40 cursor-pointer";
        }
        btn.className = cls;

        if (!isPast && !isClosed) {
          btn.addEventListener("click", () => {
            selectedDate = cellDate;
            selectedTime = null;
            renderCalendar();
            renderSlots();
            updateContinueState();
          });
        }
        calendarGrid.appendChild(btn);
      }
    }

    function renderSlots() {
      slotsList.innerHTML = "";
      if (!selectedDate) {
        slotsHeading.textContent = "Pick a date";
        slotsList.innerHTML = '<p class="text-sm text-muted font-sans">Choose a date to see open times.</p>';
        return;
      }

      slotsHeading.textContent = `${DAY_NAMES[selectedDate.getDay()]}, ${MONTH_NAMES[selectedDate.getMonth()]} ${selectedDate.getDate()}`;
      const slots = getSlotsForDate(selectedDate);

      if (slots.length === 0) {
        slotsList.innerHTML = '<p class="text-sm text-muted font-sans">Closed this day. Please pick another.</p>';
        return;
      }

      slots.forEach((slot) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = slot.time;
        const isSelected = selectedTime === slot.time;

        let cls = "w-full text-left px-3.5 py-2.5 rounded-lg border transition ";
        if (!slot.available) {
          cls += "border-line text-line line-through cursor-not-allowed bg-white";
          btn.disabled = true;
        } else if (isSelected) {
          cls += "bg-primary text-white border-primary font-medium";
        } else {
          cls += "border-line text-ink hover:border-accent hover:bg-accent-light cursor-pointer";
        }
        btn.className = cls;

        if (slot.available) {
          btn.addEventListener("click", () => {
            selectedTime = slot.time;
            renderSlots();
            updateContinueState();
          });
        }
        slotsList.appendChild(btn);
      });
    }

    function updateContinueState() {
      const ready = Boolean(selectedDate && selectedTime);
      continueBtn.disabled = !ready;
      continueBtn.classList.toggle("opacity-40", !ready);
      continueBtn.classList.toggle("cursor-not-allowed", !ready);
    }

    prevBtn.addEventListener("click", () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });
    nextBtn.addEventListener("click", () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });

    // ---------- Step navigation ----------
    const stepDatetime = document.getElementById("step-datetime")!;
    const stepDetails = document.getElementById("step-details")!;
    const stepConfirm = document.getElementById("step-confirm")!;

    function setStepIndicator(activeStep: number) {
      for (let n = 1; n <= 3; n++) {
        const dot = document.querySelector(`[data-step-dot="${n}"]`);
        const label = document.querySelector(`[data-step-label="${n}"]`);
        if (!dot) continue;
        if (n < activeStep) {
          dot.className = "absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-primary/20 text-primary flex items-center justify-center text-[11px] font-semibold";
          dot.innerHTML = "&#10003;";
          label!.className = "text-sm font-semibold text-ink";
        } else if (n === activeStep) {
          dot.className = "absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-[11px] font-semibold paw-marker";
          dot.textContent = String(n);
          label!.className = "text-sm font-semibold text-ink";
        } else {
          dot.className = "absolute left-[-2.05rem] top-0 w-6 h-6 rounded-full bg-white border-2 border-line text-muted flex items-center justify-center text-[11px] font-semibold";
          dot.textContent = String(n);
          label!.className = "text-sm font-semibold text-muted";
        }
      }
    }

    continueBtn.addEventListener("click", () => {
      if (!selectedDate || !selectedTime) return;
      const summaryText = document.getElementById("selection-summary-text")!;
      summaryText.textContent = `${DAY_NAMES[selectedDate.getDay()]}, ${MONTH_NAMES[selectedDate.getMonth()]} ${selectedDate.getDate()} at ${selectedTime} · 30 min visit`;
      stepDatetime.classList.add("hidden");
      stepDetails.classList.remove("hidden");
      setStepIndicator(2);
    });

    document.getElementById("back-to-datetime")!.addEventListener("click", () => {
      stepDetails.classList.add("hidden");
      stepDatetime.classList.remove("hidden");
      setStepIndicator(1);
    });

    // ---------- Species picker ----------
    const speciesButtons = document.querySelectorAll<HTMLButtonElement>(".species-btn");
    const speciesInput = document.getElementById("pet-species") as HTMLInputElement;
    speciesButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        speciesButtons.forEach((b) => (b.className = "species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition"));
        btn.className = "species-btn flex flex-col items-center gap-1 py-3 rounded-lg border-2 border-primary bg-primary/5 text-xs font-semibold transition";
        speciesInput.value = btn.dataset.species ?? "";
      });
    });

    // ---------- Form submit ----------
    const form = document.getElementById("booking-form") as HTMLFormElement;
    const formError = document.getElementById("form-error")!;
    let lastBooking: {
      petName: string;
      species: string;
      ownerName: string;
      email: string;
      date: Date;
      time: string;
    } | null = null;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!speciesInput.value) {
        formError.textContent = "Please select what kind of pet is coming in.";
        formError.classList.remove("hidden");
        return;
      }
      formError.classList.add("hidden");

      lastBooking = {
        petName: (document.getElementById("pet-name") as HTMLInputElement).value.trim(),
        species: speciesInput.value,
        ownerName: (document.getElementById("owner-name") as HTMLInputElement).value.trim(),
        email: (document.getElementById("owner-email") as HTMLInputElement).value.trim(),
        date: selectedDate!,
        time: selectedTime!,
      };

      document.getElementById("confirm-email")!.textContent = lastBooking.email;
      document.getElementById("confirm-pet")!.textContent = `${lastBooking.petName} (${lastBooking.species})`;
      document.getElementById("confirm-date")!.textContent = `${DAY_NAMES[selectedDate!.getDay()]}, ${MONTH_NAMES[selectedDate!.getMonth()]} ${selectedDate!.getDate()}, ${selectedDate!.getFullYear()}`;
      document.getElementById("confirm-time")!.textContent = selectedTime!;

      stepDetails.classList.add("hidden");
      stepConfirm.classList.remove("hidden");
      setStepIndicator(3);
    });

    // ---------- .ics download ----------
    function parseTimeToMinutes(label: string) {
      const [time, ampm] = label.split(" ");
      let [h, m] = time.split(":").map(Number);
      if (ampm === "PM" && h !== 12) h += 12;
      if (ampm === "AM" && h === 12) h = 0;
      return h * 60 + m;
    }

    function pad(n: number) { return String(n).padStart(2, "0"); }

    function toICSDate(date: Date, minutesFromMidnight: number) {
      const d = new Date(date);
      d.setHours(0, minutesFromMidnight, 0, 0);
      return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(d.getHours())}${pad(d.getMinutes())}00`;
    }

    document.getElementById("add-to-calendar")!.addEventListener("click", () => {
      if (!lastBooking) return;
      const startMin = parseTimeToMinutes(lastBooking.time);
      const endMin = startMin + APPT_MINUTES;
      const ics = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//NovaVet Animal Hospital//Booking//EN",
        "BEGIN:VEVENT",
        `UID:${Date.now()}@novavet.example`,
        `DTSTART:${toICSDate(lastBooking.date, startMin)}`,
        `DTEND:${toICSDate(lastBooking.date, endMin)}`,
        `SUMMARY:Vet visit — ${lastBooking.petName}`,
        `DESCRIPTION:Wellness check-up for ${lastBooking.petName} (${lastBooking.species}) with Dr. Amelia Cruz.`,
        "LOCATION:NovaVet Animal Hospital, 428 Alder Street",
        "END:VEVENT",
        "END:VCALENDAR",
      ].join("\r\n");

      const blob = new Blob([ics], { type: "text/calendar" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${lastBooking.petName || "pet"}-vet-visit.ics`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });

    document.getElementById("book-another")!.addEventListener("click", () => {
      selectedDate = null;
      selectedTime = null;
      lastBooking = null;
      form.reset();
      speciesInput.value = "";
      speciesButtons.forEach((b) => (b.className = "species-btn flex flex-col items-center gap-1 py-3 rounded-lg border border-line text-xs font-medium hover:border-primary transition"));
      formError.classList.add("hidden");
      stepConfirm.classList.add("hidden");
      stepDatetime.classList.remove("hidden");
      setStepIndicator(1);
      renderCalendar();
      renderSlots();
      updateContinueState();
    });

    // ---------- Init ----------
    renderCalendar();
    renderSlots();
    updateContinueState();
  })();
</script>
