---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<a
  href="#booking"
  class="group bg-surface border border-line rounded-2xl p-6 hover:border-teal transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-teal"
>
  <p class="font-display font-600 text-lg text-ink mb-1.5">{title}</p>
  <p class="text-sm text-inksoft leading-relaxed">{description}</p>
  <span
    class="inline-block mt-4 text-sm font-medium text-teal group-hover:translate-x-1 transition-transform"
  >
    Book this →
  </span>
</a>
