---
// All hardcoded for now — there's no mechanism yet to compute the next
// free slot, who's on site, or current wait times. Props exist so wiring
// this up later is a data problem, not a markup problem.
interface Props {
  status?: string;
  closesAt?: string;
  nextSlotLabel?: string;
  vetsOnSite?: number;
  avgWaitMinutes?: number;
}

const {
  status = "Open now",
  closesAt = "7:00 PM",
  nextSlotLabel = "Today, 3:40 PM",
  vetsOnSite = 4,
  avgWaitMinutes = 6,
} = Astro.props;
---

<div class="ticket-edge bg-surface border border-line rounded-2xl shadow-sm px-6 py-6">
  <div class="flex items-center gap-2 mb-4">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal opacity-60"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-teal"></span>
    </span>
    <span class="font-display font-600 text-sm text-ink">{status}</span>
    <span class="text-inksoft text-sm">· closes {closesAt}</span>
  </div>

  <div class="border-t border-dashed border-line my-4"></div>

  <p class="font-mono text-xs uppercase tracking-widest text-inksoft mb-1">Next available</p>
  <p class="font-display font-700 text-2xl text-ink">{nextSlotLabel}</p>

  <div class="border-t border-dashed border-line my-4"></div>

  <p class="font-mono text-xs text-inksoft leading-relaxed">
    {vetsOnSite} vets on site today<br />
    Avg. wait for new patients: {avgWaitMinutes} min
  </p>
</div>
